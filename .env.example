# Django
DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://xgetawaysx:change-me@localhost:5432/xgetawaysx

# PayFast (use sandbox credentials during development)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=True
PAYFAST_NOTIFY_URL=https://your-public-domain.example/api/v1/partners/webhooks/payfast/

# Yoco Checkout API (server-side only; never expose secret keys to frontend)
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# Customer-facing payment return routes (must be HTTPS in production)
PAYMENT_RETURN_URL=https://your-public-domain.example/payment/success
PAYMENT_CANCEL_URL=https://your-public-domain.example/payment/cancelled
PAYMENT_FAILURE_URL=https://your-public-domain.example/payment/failed
